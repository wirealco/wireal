# Self-hosted Wireal: copy to .env next to docker-compose.yml and fill in.
# README.md, "Self-host with Docker Compose", explains every step.
#
# Keep .env private: it holds the database password and the token signing key.

# --- Required -------------------------------------------------------------

# Three hostnames on one domain, each with a DNS A/AAAA record pointing at this
# server (ports 80 and 443 open). Caddy fetches their certificates itself.
# The app and the API must share a registrable domain (app.example.com and
# api.example.com, not two different domains): the browser only sends the
# sign-in cookies between same-site hosts.
# To try Wireal on this machine only, use app.wireal.localhost,
# api.wireal.localhost and mcp.wireal.localhost (see README).
WIREAL_APP_HOST=app.example.com
WIREAL_API_HOST=api.example.com
WIREAL_MCP_HOST=mcp.example.com

# Letters and digits only (it goes into a connection string): openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs access tokens. At least 32 random bytes, Base64: openssl rand -base64 32
# Changing it signs everyone out.
WIREAL_JWT_SIGNING_KEY=

# The first account: this address may register with a password. Everyone else
# needs an invitation to a workspace, unless WIREAL_INVITE_ONLY=false.
WIREAL_ADMIN_EMAIL=you@example.com
WIREAL_INVITE_ONLY=true

# --- Optional integrations: leave empty to turn off ------------------------

# Email. Without it, verification links are written to the API log instead:
#   docker compose logs api | grep "Verification link"
# Cloudflare Email Sending (the hosted service's provider).
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=

# Cloudflare Turnstile bot challenge on sign-in and registration. Without it,
# the forms have no challenge; the per-address rate limits still apply.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub App: GitHub sign-in (client ID and secret) and reading commits
# (app ID, slug and private key). README.md, "GitHub App", covers registering
# it; use https://<WIREAL_API_HOST>/auth/github/app/callback and
# https://<WIREAL_API_HOST>/auth/github/callback as its callback URLs.
# Put the private key in ./secrets/github-app.pem.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=0
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
# Numeric GitHub user id allowed to sign in with GitHub while invite-only.
WIREAL_ADMIN_GITHUB_ID=
